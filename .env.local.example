# BDGS Client Radar — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your Supabase credentials.
# The app works without these (falls back to sample data).

# Supabase project URL (safe to expose — public)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon key (safe to expose — RLS policies control access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (SERVER-SIDE ONLY — never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
